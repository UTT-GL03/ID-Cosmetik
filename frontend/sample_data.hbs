{
  "produits": [
    {{#repeat 20}}
    {
      "id": {{add @index 1}},
      "nom": "{{lorem min=1 max=3}}",
      "marque": "{{company}}",
      "score": {{int 0 10}},
      "description": "{{lorem min=15 max=40}}",
      "ingredients": [
        {{#repeat min=4 max=10}}
        {{add (step 3) (int 1 3)}}
        {{/repeat}}
      ]
    }
    {{/repeat}}
  ],
  "ingredients": [
    {{#repeat 30}}
    {
      "id": {{add @index 1}},
      "nom": "{{lorem min=1 max=3}}",
      "score": {{int 0 10}},
      "explication": "{{lorem min=20 max=50}}",
      "impacts": {
        "sante": "{{lorem min=10 max=25}}",
        "environnement": "{{lorem min=10 max=25}}"
      }
    }
    {{/repeat}}
  ],
  "account": [
    {{#repeat min=1 max=5}}
    {
      "id": {{add @index 1}},
      "name": "{{firstName}} {{lastName}}",
      "email": "{{email}}",
      "subscribed_since": "{{date '2020-01-01' '2024-12-31'}}",
      "next-subscription-renewal": "{{date '2024-01-01' '2024-12-31'}}",
      "productsOwned": [
        {{#repeat min=1 max=5}}
        {{add (step 4) (int 1 4)}}
        {{/repeat}}
      ]
    }
    {{/repeat}}
  ],
  "proof-donation": [
    {{#repeat min=1 max=5}}
    {
      "id": {{add @index 1}},
      "title": "{{lorem min=1 max=3}}",
      "amount": {{int 1 1000}},
      "date": "{{date '2020-01-01' '2024-12-31'}}"
    }
    {{/repeat}}
  ]
}
